# PostgreSQL Database Connection
# Supports any PostgreSQL provider: Supabase, Neon, AWS RDS, GCP Cloud SQL, Railway, local Postgres, etc.
DATABASE_URL=postgresql://postgres:password@localhost:5432/automation_hub

# Authentication Session Secret
JWT_SECRET=automation-hub-session-secret-replace-in-production

# Server Configuration
PORT=3000

# Brevo (Sendinblue) Transactional Email Configuration
BREVO_API_KEY=your-brevo-api-v3-key
BREVO_SENDER_EMAIL=notifications@automation-hub.app
BREVO_SENDER_NAME="Automation Hub"
