{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "tsx server.ts",
    "build:client": "npm run build --workspace=@workspace/automation-hub",
    "build:server": "esbuild backend/src/serverless.ts --bundle --platform=node --format=esm --outfile=api/index.js --external:pg-native && cp api/index.js \"api/[...all].js\"",
    "build": "npm run build:client && npm run build:server",
    "start": "tsx server.ts",
    "lint": "tsc --noEmit",
    "typecheck": "npm run typecheck --workspace=@workspace/automation-hub && npm run typecheck --workspace=@workspace/api-server"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "tsx": "^4.21.0",
    "vite": "^8.3.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.3.3",
    "@types/pg": "^8.23.1",
    "esbuild": "^0.25.0",
    "prettier": "^3.9.6",
    "typescript": "~5.9.3"
  }
}
