{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "tsx server.ts",
    "build": "npm run build --workspace=@workspace/automation-hub",
    "start": "tsx server.ts",
    "lint": "tsc --build",
    "typecheck": "npm run typecheck --workspace=@workspace/automation-hub && npm run typecheck --workspace=@workspace/api-server"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "tsx": "^4.21.0",
    "vite": "^8.3.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "prettier": "^3.9.6",
    "typescript": "~5.9.3"
  }
}
